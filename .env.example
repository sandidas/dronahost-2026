# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://dronahost.com

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Forms spam protection (Cloudflare Turnstile). Leave unset in local development.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Amazon SES team notifications (needs a verified sender identity). Credentials come from the AWS environment or instance role.
AWS_REGION=
SES_FROM=
SES_TO=

# Days to keep migration and consultation requests (default 730)
FORM_RETENTION_DAYS=

# Analytics. Plausible is cookieless; GA4 loads only after analytics consent.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_ID=

# Headless WordPress (blog). REST base, e.g. https://cms.dronahost.com/wp-json/wp/v2
WORDPRESS_API_URL=

# WHMCS API (domain search). Create an API role limited to domain lookup.
WHMCS_API_URL=
WHMCS_API_IDENTIFIER=
WHMCS_API_SECRET=

# ── Team portals (/dashboard for admins, /office for staff) ──
# Absolute site URL next-auth uses for callbacks. Local: http://localhost:3000
NEXTAUTH_URL=
# Random secret that signs next-auth cookies and tokens. Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Google OAuth client (Google Cloud Console > APIs and services > Credentials > OAuth client ID, type "Web application").
# Authorised redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated emails that always sign in as admin (role 1001) and cannot be demoted from the team screen.
ADMIN_EMAILS=
# TEMPORARY, development only: try the portals without signing in. Set to admin, staff or guest and every request
# acts as a test user (portal-test-user@dronahost.test) with that role. Ignored unless NODE_ENV is development
# (next dev), so it never works in a production build. Remove the line to turn Google sign-in back on.
PORTAL_DEV_BYPASS=

# Blog image uploads (optional). S3-compatible storage: AWS S3, Cloudflare R2, MinIO. Leave blank to hide upload; pasting an image address still works.
S3_BUCKET=
S3_REGION=
# Only for non-AWS storage, e.g. https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL the uploaded files are served from (no trailing slash), e.g. https://media.dronahost.com
S3_PUBLIC_URL=
