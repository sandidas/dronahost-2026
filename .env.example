# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://dronahost.com

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Forms spam protection (Cloudflare Turnstile). Leave unset in local development.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Amazon SES team notifications (needs a verified sender identity). Credentials come from the AWS environment or instance role.
AWS_REGION=
SES_FROM=
SES_TO=

# Days to keep migration and consultation requests (default 730)
FORM_RETENTION_DAYS=

# Analytics. Plausible is cookieless; GA4 loads only after analytics consent.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_ID=

# Headless WordPress (blog). REST base, e.g. https://cms.dronahost.com/wp-json/wp/v2
WORDPRESS_API_URL=

# WHMCS API (domain search). Create an API role limited to domain lookup.
WHMCS_API_URL=
WHMCS_API_IDENTIFIER=
WHMCS_API_SECRET=
