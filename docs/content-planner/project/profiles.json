{
  "$comment": "What a page must show for its search intent (IN1 to IN4) and to be trusted (TR1 to TR5). Rules: rules/search-intent.md and rules/eeat-and-people-first.md. Schema: schemas/profiles.ts. Every rule starts as a warning (decision 40); set a rule to \"fail\" once the pages are measured.",
  "severity": { "IN1": "warn", "IN2": "warn", "IN3": "warn", "IN4": "warn", "TR1": "warn", "TR2": "warn", "TR3": "warn", "TR4": "warn", "TR5": "warn" },
  "intents": {
    "Learn": {
      "needs": [
        { "id": "answer", "label": "a direct answer under the H1", "any": [{ "answer": true }] },
        { "id": "nextStep", "label": "a link to a next step", "any": [{ "href": "^/" }] }
      ],
      "firstScreen": ["answer"],
      "avoidFirstScreen": [{ "label": "a link to pricing or checkout (a sales push before the answer)", "detector": { "href": "^/(pricing|checkout|signup)" } }],
      "avoidLabels": ["^(buy|order|sign up|get started)\\b"]
    },
    "Solve": {
      "needs": [
        { "id": "answer", "label": "a quick answer under the H1", "any": [{ "answer": true }] },
        { "id": "steps", "label": "numbered or named fix steps", "any": [{ "heading": "step|fix|how to|solution" }, { "text": "^\\s*(step )?\\d+[.)]\\s" }] },
        { "id": "check", "label": "a check that the fix worked", "any": [{ "text": "(check that|to confirm|you should (now )?see|if it worked|to test)" }] },
        { "id": "help", "label": "when to ask for help, with a link", "any": [{ "heading": "(still stuck|need help|ask for help|when to)" }, { "href": "^/(contact|support)" }] }
      ],
      "firstScreen": ["answer"],
      "avoidFirstScreen": [],
      "avoidLabels": ["^(buy|order|sign up)\\b", "at risk"]
    },
    "Compare": {
      "needs": [
        { "id": "verdict", "label": "a one-sentence verdict", "any": [{ "text": "(verdict|in short|short answer|our pick|choose .{1,40} if)" }] },
        { "id": "criteria", "label": "the criteria used to compare", "any": [{ "heading": "(criteria|how we (compare|compared|chose|test)|what we (compare|compared))" }] },
        { "id": "table", "label": "a comparison table", "any": [{ "table": true }] },
        { "id": "whoChooses", "label": "who should choose which option", "any": [{ "heading": "(who should|which one|best for|choose)" }] }
      ],
      "firstScreen": ["verdict"],
      "avoidFirstScreen": [],
      "avoidLabels": ["^(buy|order|sign up) now$"]
    },
    "Buy": {
      "needs": [
        { "id": "price", "label": "a visible price or a link to the pricing page", "any": [{ "sectionType": "PricingPlans" }, { "href": "^/pricing" }] },
        { "id": "risk", "label": "a risk reducer (refund, cancellation or a move that is handled for the buyer)", "any": [{ "href": "^/(refund|money-back)" }, { "text": "(money-back|refund|guarantee|cancel)" }] },
        { "id": "fit", "label": "who it is for", "any": [{ "sectionType": "PathRouter" }, { "text": "(for (small business|freelancers|agencies)|best for|who (this|it) is for|right for)" }] },
        { "id": "cta", "label": "one clear primary action", "any": [{ "field": "ctaPrimary" }] }
      ],
      "firstScreen": ["cta"],
      "avoidFirstScreen": [],
      "avoidLabels": []
    },
    "Find": {
      "needs": [{ "id": "link", "label": "a direct link to the place the reader wants", "any": [{ "href": "^/" }] }],
      "firstScreen": ["link"],
      "avoidFirstScreen": [],
      "avoidLabels": []
    },
    "Plan": {
      "needs": [
        { "id": "criteria", "label": "the decision criteria", "any": [{ "heading": "(criteria|how to (choose|decide)|what to consider)" }] },
        { "id": "recommendation", "label": "a recommendation with its reason", "any": [{ "text": "(we recommend|our recommendation|start with|choose .{1,40} if)" }] },
        { "id": "nextStep", "label": "a link to a next step", "any": [{ "href": "^/" }] }
      ],
      "firstScreen": [],
      "avoidFirstScreen": [],
      "avoidLabels": ["pressure"]
    }
  },
  "trust": {
    "identity": { "appliesTo": ["product", "decision", "trust", "landing", "article"], "hrefs": ["/about", "/contact"], "siteWideFile": "../../content/navigation.ts" },
    "policies": { "appliesTo": ["product", "landing"], "hrefs": ["/refund-policy", "/support-policy", "/pricing-policy", "/backup-policy", "/migration-terms"], "min": 2 },
    "authority": {
      "patterns": ["\\b(the best|best-in-class|#1|number one|leading provider|fastest|award[- ]winning|trusted by|world[- ]class|industry[- ]leading|top[- ]rated|most reliable|unbeatable)\\b"]
    },
    "honestLimits": {
      "appliesTo": ["product", "decision", "landing"],
      "any": [{ "text": "(not (for|the right|a good fit)|isn.t (for|the right|a good fit)|(does not|doesn.t) (include|cover|offer)|only (covers|for)|one website per)" }, { "heading": "(not for|who it.s not|limits|what.s not)" }]
    },
    "freshness": { "appliesTo": ["product", "decision", "trust", "landing", "article"], "maxAgeDays": 180 }
  },
  "owed": [
    { "match": "leadFormReady", "label": "A support email, or a form route, so the free-move form can send", "who": "owner" },
    { "match": "pricesConfirmed", "label": "Confirmed prices in data/pricing.json", "who": "owner" },
    { "match": "claim:(uptime-sla|ttfb|first-reply|founded)", "label": "A measured number with its source (uptime, speed, first reply, year founded)", "who": "owner" },
    { "match": "verifiedReviews", "label": "Real reviews with the reviewer's name, role and permission", "who": "customers, via owner" },
    { "match": "^Evidence\\|", "label": "One approved case study with real numbers", "who": "owner and customer" },
    { "match": "claim:(business-hosting-scope|managed-vps-scope)", "label": "Confirmation of what business hosting and managed VPS include", "who": "owner" },
    { "match": "screenshot", "label": "A real product screenshot", "who": "owner" }
  ]
}
