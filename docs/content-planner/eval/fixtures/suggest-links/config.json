{
  "$comment": "Fixture config. Paths are relative to this file.",
  "name": "ExampleCo",
  "locale": "en-US",
  "paths": {
    "register": "register.md",
    "pricing": "none.json",
    "claims": "none.ts",
    "company": "none.ts",
    "pages": "pages",
    "posts": null,
    "briefs": "briefs",
    "facts": "facts",
    "drafts": "drafts",
    "rulesConfig": "rules.json"
  },
  "adapters": {
    "claims": "ts-export",
    "pricing": "json",
    "posts": "files",
    "pageSpec": {
      "$comment": "App-specific Zod page-spec and layout-signature checks stay in the app (owner decision, Q9). check-content calls this command; it is not copied into schemas/.",
      "command": "npm run check:pages",
      "nonCopyKeys": [
        "id",
        "type",
        "variant",
        "icon",
        "href",
        "source",
        "show",
        "highlight",
        "claims",
        "tiles",
        "channels",
        "links",
        "requires",
        "requiresClaim",
        "hoursFrom",
        "onlyPublished",
        "hideIfEmpty",
        "showRenewalPrice"
      ],
      "labelKeys": [
        "label",
        "cta"
      ]
    }
  },
  "governor": {
    "maxInFlight": 3,
    "monthlyNewPages": 4,
    "paused": false
  },
  "cta": {
    "bannedLabels": [],
    "cardLabelTemplate": "Choose {plan}"
  },
  "limits": {
    "titleSuffix": " | ExampleCo",
    "titleWarnAbove": 60,
    "titleFailAbove": 70,
    "descriptionWarnAbove": 160,
    "sentenceMax": 28,
    "averageSentenceMax": 20,
    "gradeTarget": [
      8,
      10
    ],
    "gradeWarnAbove": 10,
    "gradeFailAbove": 11,
    "answerBlockWords": [
      40,
      80
    ],
    "faqItems": [
      4,
      6
    ],
    "faqAnswerWarnBelow": 40,
    "faqAnswerFailAbove": 80,
    "internalLinksMin": 3,
    "faqItemsByPlan": {
      "01": [
        4,
        8
      ]
    },
    "similarity": {
      "shingleWords": 5,
      "threshold": 0.3
    },
    "linksSuggested": 3
  },
  "web": {
    "serpSource": "claude-web",
    "gscSource": "csv"
  }
}