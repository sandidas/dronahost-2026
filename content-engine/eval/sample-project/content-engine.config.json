{
  "$comment": "Host integration. Every path is relative to this file. Schema: schemas/config.ts",
  "paths": {
    "register": "project/keyword-register.md",
    "pricing": "project/pricing.json",
    "claims": "project/claims.json",
    "company": "project/company.json",
    "pages": "project/pages",
    "posts": null,
    "briefs": "project/briefs",
    "facts": "project/facts",
    "drafts": "project/drafts",
    "rulesConfig": "project/rules.config.json",
    "settings": "project/settings.json",
    "voice": "project/voice.json"
  },
  "adapters": {
    "claims": "json",
    "pricing": "json",
    "posts": "files",
    "wordpress": {
      "apiUrlEnv": "WORDPRESS_API_URL",
      "userEnv": "WORDPRESS_USER",
      "passwordEnv": "WORDPRESS_APP_PASSWORD",
      "webhookSecretEnv": "CONTENT_WEBHOOK_SECRET",
      "urlTemplate": "/kb/{slug}",
      "fields": {
        "title": "title.rendered",
        "slug": "slug",
        "content": "content.rendered",
        "author": "_embedded.author.0.name",
        "seo_title": "meta.seo_title",
        "meta_description": "meta.meta_description",
        "primary_keyword": "meta.primary_keyword",
        "plan": "meta.plan",
        "locale": "meta.locale",
        "reviewer": "meta.reviewer",
        "ai_assisted": "meta.ai_assisted",
        "reviewed_on": "meta.reviewed_on",
        "next_review_on": "meta.next_review_on",
        "author_page": "meta.author_page",
        "reviews_source": "meta.reviews_source",
        "url_path": "meta.url_path"
      },
      "stateMap": {
        "draft": "Draft",
        "auto-draft": "Draft",
        "pending": "Ready for owner review",
        "future": "Ready for owner review",
        "publish": "Published",
        "private": "Published"
      }
    },
    "pageSpec": null
  },
  "governor": {
    "maxInFlight": 3,
    "monthlyNewPages": 4,
    "paused": false
  },
  "cta": {
    "bannedLabels": [],
    "cardLabelTemplate": "Choose {plan}"
  },
  "limits": {
    "titleWarnAbove": 60,
    "titleFailAbove": 70,
    "descriptionWarnAbove": 160,
    "answerBlockWords": [
      40,
      80
    ],
    "faqItems": [
      4,
      6
    ],
    "faqAnswerWarnBelow": 40,
    "faqAnswerFailAbove": 80,
    "internalLinksMin": 3,
    "similarity": {
      "shingleWords": 5,
      "threshold": 0.3
    },
    "linksSuggested": 3,
    "faqItemsByArchetype": {
      "money": [
        6,
        8
      ],
      "pricing": [
        6,
        8
      ],
      "guide": [
        4,
        6
      ],
      "brand": [
        4,
        6
      ]
    },
    "archetypeByPlan": {
      "01": "money",
      "02": "guide",
      "03": "guide",
      "04": "guide",
      "05": "money",
      "06": "money",
      "07": "guide",
      "08": "money",
      "09": "brand",
      "10": "guide",
      "14": "guide",
      "15": "brand"
    },
    "archetypeAliases": {
      "product": "money",
      "landing": "money",
      "decision": "guide",
      "trust": "brand"
    }
  },
  "web": {
    "serpSource": "claude-web",
    "gscSource": "csv"
  }
}
