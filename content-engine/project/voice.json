{
  "$comment": "Brand voice as data: the one place to change tone, readability limits, spelling, word swaps and the banned lists. The checks read it (V1 to V11, M1) and `npm run content:voice` prints it as a card for writers and agents. Schema: schemas/voice.ts. Worked examples per page type stay in project/brand.md.",
  "summary": "Confident, precise, calm: the voice of a premium global brand. Plain international English, grade 8 to 10, for a smart reader who may not read English as a first language.",
  "attributes": [
    {
      "name": "Confident",
      "means": "Speak as a global brand: state verified facts plainly, never hopes. Never \"we try our best\", never \"small team\"."
    },
    {
      "name": "Specific",
      "means": "Numbers, plans and steps. Never a vague adjective where a verified metric can stand."
    },
    {
      "name": "Calm",
      "means": "No urgency that is not real. No exclamation marks in marketing copy. No countdowns without a genuine deadline."
    },
    {
      "name": "Honest",
      "means": "Every number, size, location and customer claim has a published fact behind it. Say what a plan does not include. Never name a channel we do not offer."
    },
    {
      "name": "Technical, second",
      "means": "Lead with the outcome in plain words, then give the technical term in the same sentence or a short \"How it works\" line. The reader is a business owner, not a sysadmin."
    }
  ],
  "spectrum": {
    "tooFormal": "We are pleased to inform you that your hosting account has been provisioned successfully.",
    "tooCasual": "OMG your site is live!!",
    "target": "Your hosting is ready. Here is how to log in."
  },
  "writeLike": [
    "Fathom Analytics",
    "Kinsta",
    "Cloudways",
    "Basecamp",
    "Bunny.net"
  ],
  "neverWriteLike": [
    "hype-driven reseller sites built on pressure and countdowns"
  ],
  "person": {
    "we": "DronaHost as a company, only for something it actually does",
    "you": "the reader, a business deciding or fixing something"
  },
  "readability": {
    "gradeTarget": [
      8,
      10
    ],
    "gradeWarnAbove": 10,
    "gradeFailAbove": 11,
    "sentenceMax": 28,
    "averageSentenceMax": 20
  },
