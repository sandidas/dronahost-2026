{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint",
    "build": "tsx scripts/check-contrast.ts && tsx scripts/generate-llms-txt.ts && next build",
    "generate:llms": "tsx scripts/generate-llms-txt.ts",
    "check:contrast": "tsx scripts/check-contrast.ts",
    "screenshot": "tsx scripts/screenshot.ts",
    "qa:axe": "tsx scripts/qa/axe.ts",
    "qa:links": "tsx scripts/qa/links.ts",
    "qa:jsonld": "tsx scripts/qa/jsonld.ts",
    "qa:entities": "tsx scripts/qa/entities.ts",
    "qa": "npm run check:contrast && npm run qa:axe && npm run qa:links && npm run qa:jsonld && npm run qa:entities",
    "test:e2e": "playwright test",
    "check:pages": "tsx scripts/validate-pages.ts",
    "lint:content": "tsx scripts/lint-content.ts",
    "check:register": "tsx docs/content-planner/tools/check-register.ts",
    "check:vs": "tsx scripts/check-vs.ts",
    "check:content": "tsx docs/content-planner/tools/check-content.ts",
    "test:content": "tsx --test docs/content-planner/tools/check-content.test.ts",
    "check:config": "tsx docs/content-planner/tools/check-config.ts",
    "check:no-brand": "tsx docs/content-planner/tools/check-no-brand.ts",
    "check:links": "tsx docs/content-planner/tools/check-links.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1146.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "mongoose": "^9.4.1",
    "next": "16.2.2",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanitize-html": "^2.18.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
